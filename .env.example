# BreatheWise AI — Environment Configuration Template
# Copy this file to .env.local and populate with your secure local secrets.
# Do NOT commit .env.local to version control.

# Node Environment
NODE_ENV=development
PORT=3000

# Base URL & Trusted Origins (CSRF Defense)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional Redis Configuration for Distributed Multi-Node Rate Limiting (M8.1)
# Leave unset for local development (uses process-local in-memory sliding window)
REDIS_URL=""

# Reverse Proxy Trust Configuration for Client IP Extraction (M8.1)
# Set to "true" only when behind a verified ingress proxy (e.g., Cloudflare, NGINX, AWS ALB)
TRUST_PROXY="false"

# Database Configuration (PostgreSQL primary database)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/challenge_6?schema=public"

# Authentication & Session Security (Min 32 random characters for encryption)
SESSION_SECRET="change-this-to-a-secure-random-32-char-string-in-local-env"

# External Air Quality API Credentials
# OpenAQ API v3 Key (Obtain free at https://openaq.org)
OPENAQ_API_KEY=""

# Generative AI Credentials (M5)
# Google Gemini API Key (Obtain from https://aistudio.google.com)
GEMINI_API_KEY=""
# Primary Production Model: Gemini 3 Flash (Verified in Google AI Studio)
GEMINI_MODEL="gemini-3-flash-preview"
# Alternative / High-Reasoning Model: Gemini 3.8 Flash (Verified in Google AI Studio)
GEMINI_ALTERNATIVE_MODEL="gemini-3.8-flash"

# Optional Fallback LLM / OpenAI Compatible Endpoint
FALLBACK_AI_API_KEY=""
FALLBACK_AI_BASE_URL=""
