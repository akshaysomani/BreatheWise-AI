# BreatheWise AI — Environment Configuration Template
# Copy this file to .env.local and populate with your secure local secrets.
# Do NOT commit .env.local to version control.

# Node Environment
NODE_ENV=development
PORT=3000

# Base URL & Trusted Origins (CSRF Defense)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional Redis Configuration for Distributed Multi-Node Rate Limiting (M3.1)
# Leave unset for local development (uses process-local in-memory sliding window)
REDIS_URL=""

# Database Configuration (SQLite for deterministic local verification)
DATABASE_URL="file:./dev.db"

# Authentication & Session Security (Min 32 random characters for encryption)
SESSION_SECRET="change-this-to-a-secure-random-32-char-string-in-local-env"

# External Air Quality API Credentials
# OpenAQ API v3 Key (Obtain free at https://openaq.org)
OPENAQ_API_KEY=""

# Generative AI Credentials (M5)
# Google Gemini API Key (Obtain from https://aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Optional Fallback LLM / OpenAI Compatible Endpoint
FALLBACK_AI_API_KEY=""
FALLBACK_AI_BASE_URL=""
